{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "WISE preparation catalogue",
 "description": "An analyst's local declaration of a source collection and the event views prepared from it (#99). The catalogue names sources by paths relative to the collection folder; it stays on the analyst's computer and is never committed for a private collection.",
 "type": "object",
 "additionalProperties": false,
 "required": ["format", "title", "sources", "views"],
 "properties": {
  "format": {"const": "wise.preparation_catalogue.v1"},
  "title": {"type": "string", "minLength": 1},
  "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Source"}},
  "views": {"type": "array", "items": {"$ref": "#/$defs/View"}}
 },
 "$defs": {
  "Id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
  "Role": {"enum": ["event_log", "object_centric_event_log", "static_master_data", "earlier_analysis_state", "cache",
                    "earlier_workspace", "documentation", "archive", "unreviewed"],
           "description": "The analytical role. Only event_log and object_centric_event_log sources can be prepared into views; static master data only joins a view as a declared snapshot; the other roles are recorded and never presented as event logs."},
  "Kind": {"enum": ["csv", "xes", "ocel2_json", "zip_archive", "json", "text", "binary", "spreadsheet", "directory"]},
  "Alias": {"type": "object", "additionalProperties": false, "required": ["classification"],
   "properties": {
    "classification": {"enum": ["original", "byte_identical_copy", "subset_of", "derived_from"]},
    "of": {"$ref": "#/$defs/Id"},
    "selection": {"type": "string", "description": "For a subset: how it was selected, as supplied."}},
   "allOf": [{"if": {"properties": {"classification": {"const": "original"}}}, "then": {"not": {"required": ["of"]}}, "else": {"required": ["of"]}}]},
  "Provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "licence", "obtained"],
   "properties": {"origin": {"type": "string", "minLength": 1}, "licence": {"type": "string", "minLength": 1},
                  "obtained": {"type": "string", "format": "date"}, "notes": {"type": "string"}}},
  "Member": {"type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "role", "alias"],
   "properties": {"id": {"$ref": "#/$defs/Id"}, "name": {"type": "string", "minLength": 1}, "kind": {"$ref": "#/$defs/Kind"},
                  "role": {"$ref": "#/$defs/Role"}, "alias": {"$ref": "#/$defs/Alias"},
                  "snapshot": {"$ref": "#/$defs/Snapshot"}}},
  "Snapshot": {"type": "object", "additionalProperties": false, "required": ["as_of", "meaning"],
   "properties": {"as_of": {"type": "string", "format": "date"}, "meaning": {"type": "string", "minLength": 1}}},
  "Source": {"type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "role", "alias", "provenance"],
   "properties": {"id": {"$ref": "#/$defs/Id"}, "path": {"type": "string", "minLength": 1, "description": "Relative to the collection folder, with forward slashes."},
                  "kind": {"$ref": "#/$defs/Kind"}, "role": {"$ref": "#/$defs/Role"}, "alias": {"$ref": "#/$defs/Alias"},
                  "provenance": {"$ref": "#/$defs/Provenance"}, "snapshot": {"$ref": "#/$defs/Snapshot"},
                  "members": {"type": "array", "items": {"$ref": "#/$defs/Member"}}}},
  "Join": {"type": "object", "additionalProperties": false, "required": ["master", "view_key", "master_key", "columns"],
   "properties": {"master": {"$ref": "#/$defs/Id"}, "view_key": {"type": "string"}, "master_key": {"type": "string"},
                  "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}},
  "Origin": {"enum": ["event_attribute", "case_attribute_repeated", "static_snapshot_join", "join_status", "xes_lifecycle",
                      "source_position", "ocel_event_identity", "ocel_qualifier"]},
  "View": {"type": "object", "additionalProperties": false,
   "required": ["id", "source", "conversion", "case_grain", "dialect", "mapping", "context_origin", "time", "lifecycle", "source_order", "rows",
                "observation_horizon", "pilot"],
   "properties": {
    "id": {"$ref": "#/$defs/Id"},
    "source": {"$ref": "#/$defs/Id", "description": "A source or archive member id."},
    "conversion": {"oneOf": [
     {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["csv_as_is", "xes_to_csv"]}}},
     {"type": "object", "additionalProperties": false, "required": ["kind", "object_type"],
      "properties": {"kind": {"const": "ocel_object_type"}, "object_type": {"type": "string", "minLength": 1}}}]},
    "joins": {"type": "array", "items": {"$ref": "#/$defs/Join"}},
    "case_grain": {"type": "string", "minLength": 1},
    "dialect": {"type": "object", "additionalProperties": false, "required": ["encoding", "delimiter", "quotechar", "header"],
     "properties": {"encoding": {"enum": ["utf-8", "utf-8-sig", "windows-1252"]}, "delimiter": {"enum": [",", ";", "\t", "|"]},
                    "quotechar": {"const": "\""}, "header": {"const": "first_record"}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["case", "activity", "time", "sequence", "context"],
     "properties": {"case": {"type": "string"}, "activity": {"type": "string"}, "time": {"type": "string"},
                    "sequence": {"type": ["string", "null"]}, "context": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "context_origin": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Origin"}},
    "time": {"type": "object", "additionalProperties": false, "required": ["format", "clock", "snapshot_cutoff"],
     "properties": {"format": {"enum": ["iso8601", "dmy_dot_minute", "dmy_slash_minute", "mdy_slash_minute", "mdy_dot_minute", "dmy_dot_second",
                                        "dmy_dash_second", "mdy_dot_second", "dmy_slash_second", "mdy_slash_second", "mdy_slash_12h_minute",
                                        "mdy_slash_12h_second", "ymd_slash_second"]},
                    "clock": {"enum": ["offset_in_values", "fixed_offset", "wall_clock_as_recorded"]},
                    "offset_minutes": {"type": "integer", "minimum": -840, "maximum": 840},
                    "snapshot_cutoff": {"type": "string"}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["reading"],
     "properties": {"reading": {"enum": ["not_recorded", "transition_as_context"]}, "pairing": {"const": "none"}}},
    "source_order": {"enum": ["file_record_order", "xes_document_order", "ocel_event_order"]},
    "rows": {"enum": ["tolerant", "strict"]},
    "observation_horizon": {"type": "object", "additionalProperties": false, "required": ["start", "end", "basis"],
     "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "basis": {"type": "string", "minLength": 1}}},
    "pilot": {"type": "object", "additionalProperties": false, "required": ["case_count"],
     "properties": {"case_count": {"type": "integer", "minimum": 1, "maximum": 100}}}}}
 }
}
