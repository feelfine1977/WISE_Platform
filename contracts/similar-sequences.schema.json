{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/similar-sequences.v1.schema.json",
  "title": "SimilarSequencesMessage",
  "description": "Suggestions of incidents whose sequence of labelled activities is within a fixed number of edits of a chosen sequence, as families of exactly equal sequences of the frozen parent with their distance and support. The method is fixed before filtering; a suggestion is not applied by the service and is not a class, a cause or a prediction.",
  "oneOf": [
    {
      "$ref": "#/$defs/SimilarSequencesRequest"
    },
    {
      "$ref": "#/$defs/SimilarSequencesAnswer"
    },
    {
      "$ref": "#/$defs/SimilarSequencesRefusal"
    }
  ],
  "$defs": {
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "QueryRevision": {
      "title": "QueryRevision",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "WorkspaceId": {
      "title": "WorkspaceId",
      "type": "string",
      "pattern": "^workspace\\.v1:[A-Za-z0-9-]{8,64}$"
    },
    "SourceId": {
      "title": "SourceId",
      "type": "string",
      "pattern": "^source\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PreparationId": {
      "title": "PreparationId",
      "type": "string",
      "pattern": "^preparation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "RepresentationId": {
      "title": "RepresentationId",
      "type": "string",
      "pattern": "^representation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "CaseDictionaryId": {
      "title": "CaseDictionaryId",
      "type": "string",
      "pattern": "^case-dictionary\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PopulationId": {
      "title": "PopulationId",
      "type": "string",
      "pattern": "^population\\.v1:sha256:[a-f0-9]{64}$"
    },
    "ImplementationVersion": {
      "title": "ImplementationVersion",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "AnswerIdentity": {
      "title": "AnswerIdentity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "preparation_id": {
          "$ref": "#/$defs/PreparationId"
        },
        "representation_id": {
          "$ref": "#/$defs/RepresentationId"
        },
        "case_dictionary_id": {
          "$ref": "#/$defs/CaseDictionaryId"
        },
        "population_id": {
          "$ref": "#/$defs/PopulationId"
        },
        "implementation_version": {
          "$ref": "#/$defs/ImplementationVersion"
        }
      },
      "required": [
        "source_id",
        "preparation_id",
        "representation_id",
        "case_dictionary_id",
        "population_id",
        "implementation_version"
      ]
    },
    "SequenceFamily": {
      "title": "SequenceFamily",
      "type": "object",
      "additionalProperties": false,
      "description": "The incidents of the parent with exactly this sequence of labelled activities, at its edit distance from the chosen sequence.",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 500
        },
        "distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parent_case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kept_case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exemplars": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "activities",
        "distance",
        "parent_case_count",
        "kept_case_ids",
        "exemplars"
      ]
    },
    "SimilarSequencesRequest": {
      "title": "SimilarSequencesRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "similar_sequences_request"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 500
        },
        "maximum_edits": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "anchor",
        "maximum_edits"
      ]
    },
    "SimilarSequencesAnswer": {
      "title": "SimilarSequencesAnswer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "similar_sequences_answer"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "parent_identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "policy": {
          "type": "string",
          "const": "incident.sequence.similar.edit_distance.v1"
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 500
        },
        "maximum_edits": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "eligible_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unevaluable_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "case_count",
            "eligible_case_count",
            "unevaluable_case_count"
          ]
        },
        "kept_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "suggested_parent_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "suggested_kept_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "family_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceFamily"
          }
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "parent_identity",
        "policy",
        "anchor",
        "maximum_edits",
        "parent",
        "kept_case_count",
        "suggested_parent_case_count",
        "suggested_kept_case_count",
        "family_count",
        "families"
      ]
    },
    "SimilarSequencesRefusal": {
      "title": "SimilarSequencesRefusal",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "similar_sequences_refusal"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "type": "string",
          "const": "similar_sequences"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unsupported_schema",
            "invalid_parameter",
            "workspace_unavailable",
            "workspace_not_writable",
            "workspace_incompatible",
            "source_unavailable",
            "preparation_unavailable",
            "identity_mismatch",
            "population_unavailable",
            "memory_unavailable",
            "computation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "operation",
        "code",
        "message",
        "field",
        "retryable"
      ]
    }
  }
}
