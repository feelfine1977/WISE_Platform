    "Bpic19OperatorRefusal": {
      "title": "Bpic19OperatorRefusal",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "message_type": {
          "const": "bpic19_operator_refusal"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "const": "bpic19_operators"
        },
        "code": {
          "type": "string",
          "description": "Operator horizon conflicts use incompatible_clock or incompatible_horizon; raw-source and preparation failures retain their original codes. method_binding_unavailable means no admitted actual Method binding for this finite rule family, independently of native installation; method_context identifies the validated descriptive rule."
        },
        "message": {
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "method_context": {
          "$ref": "#/$defs/RuleMethodContext"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "operation",
        "code",
        "message",
        "field",
        "retryable"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "method_binding_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "method_context"
            ],
            "properties": {
              "field": {
                "const": "intent"
              },
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "method_context"
              ]
            }
          }
        }
      ]
    },
    "RuleMethodContext": {
      "title": "RuleMethodContext",
      "type": "object",
      "additionalProperties": false,
