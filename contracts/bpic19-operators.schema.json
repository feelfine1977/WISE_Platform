    "Bpic19OperatorRequest": {
      "title": "Bpic19OperatorRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "const": "bpic19_operator_request"
        },
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "query": {
          "$ref": "#/$defs/OperatorQuery"
        },
        "intent": {
          "type": "string",
          "enum": [
            "descriptive",
            "normative_admission"
          ],
          "description": "Omitted or descriptive retains recorded-event evidence. normative_admission asks actual Method admission for this exact rule, without supplying a Norm or grade; intent is outside descriptive query identity."
        }
      },
      "required": [
        "message_type",
        "schema_version",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "query"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "normative_admission"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "properties": {
              "query": {
                "properties": {
                  "recipe": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "rule"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
