{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/workspace-backup.v1.schema.json",
  "title": "WorkspaceBackupMessage",
  "description": "Application-aware backup of a local workspace and its checked restore into another folder, keeping the workspace's identity.",
  "oneOf": [
    {
      "$ref": "#/$defs/BackUpWorkspaceRequest"
    },
    {
      "$ref": "#/$defs/BackUpWorkspaceAnswer"
    },
    {
      "$ref": "#/$defs/RestoreWorkspaceRequest"
    },
    {
      "$ref": "#/$defs/RestoreWorkspaceAnswer"
    },
    {
      "$ref": "#/$defs/WorkspaceBackupRefusal"
    }
  ],
  "$defs": {
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "QueryRevision": {
      "title": "QueryRevision",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "WorkspaceId": {
      "title": "WorkspaceId",
      "type": "string",
      "pattern": "^workspace\\.v1:[A-Za-z0-9-]{8,64}$"
    },
    "BackupCounts": {
      "title": "BackupCounts",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preparations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "definitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "score_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "investigations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sources",
        "preparations",
        "definitions",
        "score_runs",
        "artifacts",
        "revisions",
        "investigations"
      ]
    },
    "BackUpWorkspaceRequest": {
      "title": "BackUpWorkspaceRequest",
      "description": "Backs up an open workspace into a new or empty folder, as the application wrote it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "back_up_workspace_request"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "destination"
      ]
    },
    "BackUpWorkspaceAnswer": {
      "title": "BackUpWorkspaceAnswer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "back_up_workspace_answer"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "$ref": "#/$defs/BackupCounts"
        },
        "omitted": {
          "description": "Files of the workspace not backed up: machine settings that name folders of this computer.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "path",
        "file_count",
        "byte_count",
        "counts",
        "omitted"
      ]
    },
    "RestoreWorkspaceRequest": {
      "title": "RestoreWorkspaceRequest",
      "description": "Restores a finished backup into a new or empty folder after checking it; the workspace keeps its identity.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "restore_workspace_request"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "backup_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "backup_path",
        "destination"
      ]
    },
    "RestoreWorkspaceAnswer": {
      "title": "RestoreWorkspaceAnswer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "restore_workspace_answer"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "$ref": "#/$defs/BackupCounts"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "path",
        "file_count",
        "counts",
        "warnings"
      ]
    },
    "WorkspaceBackupRefusal": {
      "title": "WorkspaceBackupRefusal",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "workspace_backup_refusal"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "back_up_workspace",
            "restore_workspace"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unsupported_schema",
            "workspace_unavailable",
            "workspace_not_writable",
            "workspace_incompatible",
            "workspace_busy",
            "destination_unavailable",
            "backup_unavailable",
            "backup_damaged",
            "computation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "operation",
        "code",
        "message",
        "field",
        "retryable"
      ]
    }
  }
}
