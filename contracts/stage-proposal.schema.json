{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/stage-proposal.v1.schema.json",
  "title": "StageProposalMessage",
  "description": "The values a mapped context column holds on every raw record of each labelled activity of the kept incidents, with the records, incidents and missing cells of each activity, from which the analyst may propose stages. Nothing is assigned by the service, and nothing is read from a column's name.",
  "oneOf": [
    {
      "$ref": "#/$defs/StageProposalRequest"
    },
    {
      "$ref": "#/$defs/StageProposalAnswer"
    },
    {
      "$ref": "#/$defs/StageProposalRefusal"
    }
  ],
  "$defs": {
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "QueryRevision": {
      "title": "QueryRevision",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "WorkspaceId": {
      "title": "WorkspaceId",
      "type": "string",
      "pattern": "^workspace\\.v1:[A-Za-z0-9-]{8,64}$"
    },
    "SourceId": {
      "title": "SourceId",
      "type": "string",
      "pattern": "^source\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PreparationId": {
      "title": "PreparationId",
      "type": "string",
      "pattern": "^preparation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "RepresentationId": {
      "title": "RepresentationId",
      "type": "string",
      "pattern": "^representation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "CaseDictionaryId": {
      "title": "CaseDictionaryId",
      "type": "string",
      "pattern": "^case-dictionary\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PopulationId": {
      "title": "PopulationId",
      "type": "string",
      "pattern": "^population\\.v1:sha256:[a-f0-9]{64}$"
    },
    "ImplementationVersion": {
      "title": "ImplementationVersion",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "AnswerIdentity": {
      "title": "AnswerIdentity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "preparation_id": {
          "$ref": "#/$defs/PreparationId"
        },
        "representation_id": {
          "$ref": "#/$defs/RepresentationId"
        },
        "case_dictionary_id": {
          "$ref": "#/$defs/CaseDictionaryId"
        },
        "population_id": {
          "$ref": "#/$defs/PopulationId"
        },
        "implementation_version": {
          "$ref": "#/$defs/ImplementationVersion"
        }
      },
      "required": [
        "source_id",
        "preparation_id",
        "representation_id",
        "case_dictionary_id",
        "population_id",
        "implementation_version"
      ]
    },
    "ValueCount": {
      "title": "ValueCount",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "The value exactly as recorded in the cell."
        },
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "value",
        "record_count"
      ]
    },
    "ActivityValues": {
      "title": "ActivityValues",
      "type": "object",
      "additionalProperties": false,
      "description": "One labelled activity of the kept incidents: its records, the incidents that have them, and the values of the column on every one of its records, the most frequent first. The values listed, the other values' records and the missing records add up to the activity's records.",
      "properties": {
        "activity": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "incident_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "missing_record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "How many distinct values the activity's records hold."
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValueCount"
          },
          "maxItems": 50
        },
        "values_truncated": {
          "type": "boolean"
        },
        "other_record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Records holding a value beyond those listed."
        },
        "mixed": {
          "type": "boolean",
          "description": "Whether the activity's records hold more than one value."
        },
        "leading": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueCount"
            },
            {
              "type": "null"
            }
          ],
          "description": "The value more of the activity's records hold than any other; none on a tie or without a value. Offered for review, never assigned."
        }
      },
      "required": [
        "activity",
        "record_count",
        "incident_count",
        "missing_record_count",
        "value_count",
        "values",
        "values_truncated",
        "other_record_count",
        "mixed",
        "leading"
      ]
    },
    "KeptRecords": {
      "title": "KeptRecords",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "labelled_record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unlabelled_record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "case_count",
        "record_count",
        "labelled_record_count",
        "unlabelled_record_count"
      ]
    },
    "StageProposalRequest": {
      "title": "StageProposalRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "stage_proposal_request"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "column_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "column_index",
        "value_limit"
      ]
    },
    "StageProposalAnswer": {
      "title": "StageProposalAnswer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "stage_proposal_answer"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "policy": {
          "type": "string",
          "const": "incident.stage.proposal.every_record_value_counts.v1"
        },
        "column_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column_name": {
          "type": "string"
        },
        "kept": {
          "$ref": "#/$defs/KeptRecords"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityValues"
          }
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "policy",
        "column_index",
        "column_name",
        "kept",
        "activities"
      ]
    },
    "StageProposalRefusal": {
      "title": "StageProposalRefusal",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "stage_proposal_refusal"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "type": "string",
          "const": "stage_proposal"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unsupported_schema",
            "invalid_parameter",
            "workspace_unavailable",
            "workspace_not_writable",
            "workspace_incompatible",
            "source_unavailable",
            "preparation_unavailable",
            "identity_mismatch",
            "population_unavailable",
            "memory_unavailable",
            "column_not_context",
            "computation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "operation",
        "code",
        "message",
        "field",
        "retryable"
      ]
    }
  }
}
