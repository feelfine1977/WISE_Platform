          "minimum": 0
        },
        "item_type": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "goods_receipt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gr_based_iv": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "purchasing_document": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "item": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_case": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "company": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "spend_area": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "resource": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "net_worth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "paper",
            "historical"
          ]
        },
        "view": {
          "enum": [
            "Balanced",
            "Completion",
            "Operations",
            "Finance",
            "Logistics",
            "Compliance",
            "Automation"
          ]
        },
        "mode": {
          "enum": [
            "flat",
            "layer_balanced"
          ]
        },
        "gamma": {
          "type": "number",
          "minimum": 0
        },
        "group_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "company",
              "spend_area",
              "flow",
              "document",
              "item_type"
            ]
          }
        },
        "min_cases": {
          "type": "integer",
          "minimum": 1
        },
        "volume": {
          "enum": [
            "cases",
            "exposure"
          ]
        },
        "exposure_policy": {
          "enum": [
            "creation_value",
            "creation_unique_value",
            "creation_unique_event",
            "max_absolute_p95"
          ]
        },
        "criteria_family": {
          "enum": [
            "completion",
            "completion_timing",
            "completion_rework_effort",
            "full"
          ]
        },
        "association_min_support": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "profile",
        "view",
        "mode",
        "gamma",
        "group_by",
        "min_cases",
        "volume",
        "exposure_policy",
        "criteria_family"
      ]
    },
    "Bpic19ScoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "message_type": {
          "const": "bpic19_score_request"
        },
        "base_identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "named_population": {
          "$ref": "#/$defs/NamedPopulation"
        },
        "roles": {
          "$ref": "#/$defs/Roles"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "case_offset": {
          "type": "integer",
          "minimum": 0
        },
        "case_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "group_offset": {
          "type": "integer",
          "minimum": 0
        },
        "group_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "query_revision",
        "workspace_id",
        "message_type",
        "base_identity",
        "named_population",
        "roles",
        "settings",
        "case_offset",
        "case_limit"
      ]
    },
    "Bpic19ReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "message_type": {
          "const": "bpic19_read_request"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "case_offset": {
          "type": "integer",
          "minimum": 0
        },
        "case_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "group_offset": {
          "type": "integer",
          "minimum": 0
        },
        "group_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "case_filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group_values": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "criterion_id": {
              "type": "string"
            },
            "criterion_state": {
              "enum": [
                "positive",
                "evaluated",
                "unavailable"
              ]
            },
            "right_criterion_id": {
              "type": "string"
            },
            "representation_group": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "exact",
                    "signature"
                  ]
                },
                "group_id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "group_id"
              ]
            }
          },
          "minProperties": 1
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "query_revision",
        "workspace_id",
        "message_type",
        "run_id",
        "case_offset",
        "case_limit"
      ]
    },
