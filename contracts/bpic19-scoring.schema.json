          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "deviation": {
          "type": [
            "number",
            "null"
          ]
        },
        "raw_weight": {
          "type": "number"
        },
        "effective_weight": {
          "type": [
            "number",
            "null"
          ]
        },
        "penalty": {
          "type": [
            "number",
            "null"
          ]
        },
        "measurement_evidence": {
          "type": "object"
        }
      },
      "required": [
        "criterion_id",
        "layer",
        "measurement",
        "measurement_reason",
        "row_ids",
        "in_scope",
        "reason",
        "deviation",
        "raw_weight",
        "effective_weight",
        "penalty"
      ]
    },
    "NumericMap": {
