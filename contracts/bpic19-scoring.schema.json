{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/bpic19-scoring.schema.json",
  "title": "BPIC19ScoringMessage",
  "description": "Source-witnessed BPIC19 profiles executed by actual Method; bounded case pages and frozen run identity.",
  "oneOf": [
    {
      "$ref": "#/$defs/Bpic19ScoreRequest"
    },
    {
      "$ref": "#/$defs/Bpic19ReadRequest"
    },
    {
      "$ref": "#/$defs/Bpic19ScoreAnswer"
    },
    {
      "$ref": "#/$defs/Bpic19Refusal"
    },
    {
      "$ref": "#/$defs/Bpic19ExportRequest"
    }
  ],
  "$defs": {
    "AnswerIdentity": {
      "title": "AnswerIdentity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "preparation_id": {
          "$ref": "#/$defs/PreparationId"
        },
        "representation_id": {
          "$ref": "#/$defs/RepresentationId"
        },
        "case_dictionary_id": {
          "$ref": "#/$defs/CaseDictionaryId"
        },
        "population_id": {
          "$ref": "#/$defs/PopulationId"
        },
        "implementation_version": {
          "$ref": "#/$defs/ImplementationVersion"
        }
      },
      "required": [
        "source_id",
        "preparation_id",
        "representation_id",
        "case_dictionary_id",
        "population_id",
        "implementation_version"
      ]
    },
    "SourceId": {
      "title": "SourceId",
      "type": "string",
      "pattern": "^source\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PreparationId": {
      "title": "PreparationId",
      "type": "string",
      "pattern": "^preparation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "RepresentationId": {
      "title": "RepresentationId",
      "type": "string",
      "pattern": "^representation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "CaseDictionaryId": {
      "title": "CaseDictionaryId",
      "type": "string",
      "pattern": "^case-dictionary\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PopulationId": {
      "title": "PopulationId",
      "type": "string",
      "pattern": "^population\\.v1:sha256:[a-f0-9]{64}$"
    },
    "ImplementationVersion": {
      "title": "ImplementationVersion",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "WorkspaceId": {
      "title": "WorkspaceId",
      "type": "string",
      "pattern": "^workspace\\.v1:[A-Za-z0-9-]{8,64}$"
    },
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "QueryRevision": {
      "title": "QueryRevision",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "MethodArtifact": {
      "title": "MethodArtifact",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "type": "string",
          "const": "wise-pm"
        },
        "version": {
          "type": "string",
          "const": "0.2.0"
        },
        "source_commit": {
          "type": "string",
          "const": "6883db5269e622d9ce5274d207e831d12ab134fe"
        },
        "wheel_sha256": {
          "type": "string",
          "const": "7329b7929bb8a3e40c596b359f352aace23cc233d8f29322ee063612733aecc3"
        },
        "qualification": {
          "type": "string",
          "const": "candidate_component_checked_release_pending"
        },
        "eligible_release": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "distribution",
        "version",
        "source_commit",
        "wheel_sha256",
        "qualification",
        "eligible_release"
      ]
    },
    "NamedPopulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        }
      },
      "required": [
        "name",
        "identity"
      ]
    },
    "Roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_category": {
          "type": [
            "integer",
