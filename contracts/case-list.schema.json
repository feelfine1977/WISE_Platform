        "record_count",
        "mapped_record_count",
        "omitted_activity_record_count",
        "sequence_evaluable",
        "time_summary",
        "maximum_gap_context"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence_evaluable": {
                "const": false
              }
            },
            "required": [
              "sequence_evaluable"
            ]
          },
          "then": {
            "properties": {
              "time_summary": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  }
                }
              },
              "maximum_gap_context": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "time_summary": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "available"
                  }
                }
              }
            }
          }
        }
      ]
    },
