    "PathLagTotals": {
      "title": "PathLagTotals",
      "type": "object",
      "additionalProperties": false,
      "description": "Supplied totals over all usable actual paths of the selected graph, on lag_clock. Artificial boundary flows contribute no time. The top five are ranked by total lag descending, distinct incidents descending, then the supplied source/target activity order. A zero total has unavailable shares, not invented zero percentages.",
      "properties": {
        "total_hours": {
          "type": "number",
          "minimum": 0
        },
        "usable_passage_count": {
          "type": "integer",
          "minimum": 0
        },
        "usable_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_five_path_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^path\\.v1:sha256:[0-9a-f]{64}$"
          }
        },
        "top_five_total_hours": {
          "type": "number",
          "minimum": 0
        },
        "top_five_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "total_microseconds": {
          "$ref": "#/$defs/LagMicroseconds"
        },
        "top_five_total_microseconds": {
          "$ref": "#/$defs/LagMicroseconds"
        }
      },
      "required": [
        "total_hours",
        "usable_passage_count",
        "usable_path_count",
        "top_five_path_ids",
        "top_five_total_hours",
        "top_five_share",
        "total_microseconds",
        "top_five_total_microseconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "total_hours": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "top_five_share": {
                "type": "null"
              },
              "top_five_total_hours": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "top_five_share": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "LagMicroseconds": {
      "title": "LagMicroseconds",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 64,
      "description": "Exact nonnegative integer microseconds, as canonical decimal text. This is a computational coordinate on the declared clock, not an assertion of physical recording resolution.",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "StepResult": {
      "title": "StepResult",
      "description": "Supplied kept-after-step partition for an ordered prefix, counted over the same frozen parent, including all raw records.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_number": {
          "type": "integer",
          "minimum": 1
        },
        "predicate": {
          "$ref": "#/$defs/SelectionPredicate"
        },
        "kept": {
          "$ref": "#/$defs/PopulationSupport"
        },
        "removed": {
          "$ref": "#/$defs/PopulationSupport"
        },
        "unevaluable": {
          "$ref": "#/$defs/PopulationSupport"
        }
      },
      "required": [
        "step_number",
        "predicate",
        "kept",
        "removed",
        "unevaluable"
      ]
    }
  }
