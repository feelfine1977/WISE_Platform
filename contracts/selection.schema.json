    "IntervalThreshold": {
      "title": "IntervalThreshold",
      "description": "Keeps the incidents whose interval from the first record of the start activity to the first record of the response activity at or after it (the registered pairing policy) exceeds (gt) or reaches (ge) a number of hours on the preparation's clock. An incident without that interval (order not known, no start, no response at or after it) is not evaluable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "interval_threshold"
        },
        "interval": {
          "$ref": "#/$defs/IntervalDefinition"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "ge"
          ]
        },
        "hours": {
          "type": "number",
          "minimum": 0
        },
        "negate": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "interval",
        "operator",
        "hours",
        "negate"
      ]
    },
    "IntervalDefinition": {
      "title": "IntervalDefinition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "const": "incident.interval.first_start_first_response_at_or_after.v1"
        },
        "start_activity": {
          "type": "string",
          "minLength": 1
        },
        "response_activity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policy",
        "start_activity",
        "response_activity"
      ]
    },
    "VariantIs": {
      "title": "VariantIs",
      "description": "Keeps the incidents whose complete mapped sequence, in the declared order under the activity projection, is exactly the variant's sequence, repeats included. The identity is the hash of the exact labels in order and must match them. An incident whose order is not known has no sequence and is not evaluable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "variant_is"
        },
        "variant": {
          "$ref": "#/$defs/VariantDefinition"
        },
        "negate": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "variant",
        "negate"
      ]
    },
    "MeasureBetween": {
      "title": "MeasureBetween",
      "description": "Keeps the incidents whose measure lies in the range from minimum to maximum, both included; a null maximum has no upper bound. raw_record_count is the number of raw records of the incident, records without an activity label included, and every incident has it. observed_span_hours and maximum_adjacent_raw_gap_hours are those of the case-list summary (incident.case_summary.full_raw_declared_order.v1): an incident whose order is not known has neither, and one with a single record has no longest gap; such an incident is not evaluable, never inside or outside. Negation keeps the incidents outside the range; the unevaluable stay unevaluable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "measure_between"
        },
        "measure": {
          "type": "string",
          "enum": [
            "raw_record_count",
            "observed_span_hours",
            "maximum_adjacent_raw_gap_hours"
          ]
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "negate": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "measure",
        "minimum",
        "maximum",
        "negate"
      ]
    },
    "PathLagInRange": {
      "title": "PathLagInRange",
      "description": "Keeps the incidents that pass the path from source_activity to target_activity, a pair of adjacent records of the activity sequence (the passages of the map's path and of its lag), with a lag in the range: above minimum_hours and below maximum_hours, each bound included or excluded as stated, a null bound not bounding. With passages at_least_one, one passage in the range suffices; with every, the incident passes the path at least once and every passage is in the range. The lag is the elapsed time on the preparation's clock between the two records. An incident whose order is not known is not evaluable; one that never passes the path is outside. Negation keeps the incidents the condition does not keep; the unevaluable stay unevaluable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "path_lag_in_range"
        },
        "source_activity": {
          "type": "string",
          "minLength": 1
        },
        "target_activity": {
          "type": "string",
          "minLength": 1
        },
        "minimum_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "minimum_inclusive": {
          "type": "boolean"
        },
        "maximum_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum_inclusive": {
          "type": "boolean"
        },
        "passages": {
          "type": "string",
          "enum": [
            "at_least_one",
            "every"
          ]
        },
        "negate": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "source_activity",
        "target_activity",
        "minimum_hours",
        "minimum_inclusive",
        "maximum_hours",
        "maximum_inclusive",
        "passages",
        "negate"
      ]
    },
    "ContextNumberInRange": {
      "title": "ContextNumberInRange",
      "description": "Keeps the incidents whose number in a context column declared numeric at import lies in the half-open range [minimum, maximum), a null bound not bounding. The cell is read by incident.context.number.point_or_comma_decimal.v1. The projection is that of other context: the first record in the declared order, the latest record in the declared order with a value (the latest recorded at the snapshot cutoff), or any record (one of its numbers in the range suffices). An incident without the projected number, because its order is not known or the value is missing or not a number, is not evaluable; negation leaves it so.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "context_number_in_range"
        },
        "column_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projection": {
          "type": "string",
          "enum": [
            "first_record",
            "latest_record",
            "any_record"
          ]
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "negate": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "column_index",
        "projection",
        "minimum",
        "maximum",
        "negate"
      ]
    },
    "VariantDefinition": {
      "title": "VariantDefinition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^variant\\.v1:sha256:[0-9a-f]{64}$"
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projection_policy": {
          "type": "string",
          "const": "incident.activity.omit_missing_retain_raw_gaps.v1"
        }
      },
      "required": [
        "id",
        "activities",
        "projection_policy"
      ]
    },
    "RecordAttributeCondition": {
      "title": "RecordAttributeCondition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column_index": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
