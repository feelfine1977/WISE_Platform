{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/gap-pairs.v1.schema.json",
  "title": "GapPairsMessage",
  "description": "The recorded gaps between records by the pair of activities around them, for the kept incidents against the fixed parent, under a stated relation, weighting and quantile policy, with the incidents of unknown order counted apart. A gap is a recorded difference of times, never a working or waiting time; nothing is computed in the browser.",
  "oneOf": [
    {
      "$ref": "#/$defs/GapPairsRequest"
    },
    {
      "$ref": "#/$defs/GapPairsAnswer"
    },
    {
      "$ref": "#/$defs/GapPairsRefusal"
    }
  ],
  "$defs": {
    "RequestId": {
      "title": "RequestId",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "QueryRevision": {
      "title": "QueryRevision",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "WorkspaceId": {
      "title": "WorkspaceId",
      "type": "string",
      "pattern": "^workspace\\.v1:[A-Za-z0-9-]{8,64}$"
    },
    "SourceId": {
      "title": "SourceId",
      "type": "string",
      "pattern": "^source\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PreparationId": {
      "title": "PreparationId",
      "type": "string",
      "pattern": "^preparation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "RepresentationId": {
      "title": "RepresentationId",
      "type": "string",
      "pattern": "^representation\\.v1:sha256:[a-f0-9]{64}$"
    },
    "CaseDictionaryId": {
      "title": "CaseDictionaryId",
      "type": "string",
      "pattern": "^case-dictionary\\.v1:sha256:[a-f0-9]{64}$"
    },
    "PopulationId": {
      "title": "PopulationId",
      "type": "string",
      "pattern": "^population\\.v1:sha256:[a-f0-9]{64}$"
    },
    "ImplementationVersion": {
      "title": "ImplementationVersion",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "AnswerIdentity": {
      "title": "AnswerIdentity",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/SourceId"
        },
        "preparation_id": {
          "$ref": "#/$defs/PreparationId"
        },
        "representation_id": {
          "$ref": "#/$defs/RepresentationId"
        },
        "case_dictionary_id": {
          "$ref": "#/$defs/CaseDictionaryId"
        },
        "population_id": {
          "$ref": "#/$defs/PopulationId"
        },
        "implementation_version": {
          "$ref": "#/$defs/ImplementationVersion"
        }
      },
      "required": [
        "source_id",
        "preparation_id",
        "representation_id",
        "case_dictionary_id",
        "population_id",
        "implementation_version"
      ]
    },
    "GapRelation": {
      "title": "GapRelation",
      "type": "string",
      "enum": [
        "raw_adjacent",
        "mapped_path"
      ],
      "description": "raw_adjacent: two adjacent raw records in the declared order, a record without a label an endpoint of its own; mapped_path: two adjacent labelled records, a record without a label passed over, as the map's paths."
    },
    "GapPair": {
      "title": "GapPair",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        },
        "to_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        }
      },
      "required": [
        "from_activity",
        "to_activity"
      ]
    },
    "GapFigures": {
      "title": "GapFigures",
      "type": "object",
      "additionalProperties": false,
      "description": "The gaps of a pair in a group: the incidents that pass it and their share of the group's incidents whose order is known (the denominator), its passages, the median and the 90th percentile of its passages in hours under the stated policies (null without a passage), and the passages and incidents longer than the threshold.",
      "properties": {
        "incident_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incident_share": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "passage_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "median_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "p90_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "above_threshold_passage_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "above_threshold_incident_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "incident_count",
        "incident_share",
        "passage_count",
        "median_hours",
        "p90_hours",
        "above_threshold_passage_count",
        "above_threshold_incident_count"
      ]
    },
    "GapPairFigures": {
      "title": "GapPairFigures",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        },
        "to_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        },
        "kept": {
          "$ref": "#/$defs/GapFigures"
        },
        "parent": {
          "$ref": "#/$defs/GapFigures"
        }
      },
      "required": [
        "from_activity",
        "to_activity",
        "kept",
        "parent"
      ]
    },
    "GapGroup": {
      "title": "GapGroup",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluable_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "order_unknown_case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "case_count",
        "evaluable_case_count",
        "order_unknown_case_count"
      ]
    },
    "ChosenGapCase": {
      "title": "ChosenGapCase",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "longest_hours": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "case_id",
        "longest_hours"
      ]
    },
    "ChosenGapPair": {
      "title": "ChosenGapPair",
      "type": "object",
      "additionalProperties": false,
      "description": "The kept incidents that pass the chosen pair, the longest of their passages of it first, ties by incident number: an order of the list, never a selection.",
      "properties": {
        "from_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        },
        "to_activity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "An activity label; null for a record without one, an endpoint of its own under raw_adjacent."
        },
        "case_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChosenGapCase"
          }
        },
        "cases_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "from_activity",
        "to_activity",
        "case_count",
        "cases",
        "cases_truncated"
      ]
    },
    "GapPairsRequest": {
      "title": "GapPairsRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "gap_pairs_request"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "relation": {
          "$ref": "#/$defs/GapRelation"
        },
        "threshold_hours": {
          "type": "number",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "chosen": {
          "anyOf": [
            {
              "$ref": "#/$defs/GapPair"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "relation",
        "threshold_hours",
        "limit",
        "chosen",
        "case_limit"
      ]
    },
    "GapPairsAnswer": {
      "title": "GapPairsAnswer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "gap_pairs_answer"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "query_revision": {
          "$ref": "#/$defs/QueryRevision"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "parent_identity": {
          "$ref": "#/$defs/AnswerIdentity"
        },
        "relation": {
          "$ref": "#/$defs/GapRelation"
        },
        "weighting_policy": {
          "type": "string",
          "const": "incident.gap.weighting.each_passage_once.v1"
        },
        "quantile_policy": {
          "type": "string",
          "const": "incident.gap.quantiles.median_midpoint_p90_nearest_rank.v1"
        },
        "threshold_hours": {
          "type": "number",
          "minimum": 0
        },
        "kept": {
          "$ref": "#/$defs/GapGroup"
        },
        "parent": {
          "$ref": "#/$defs/GapGroup"
        },
        "pair_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pairs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/GapPairFigures"
          }
        },
        "pairs_truncated": {
          "type": "boolean"
        },
        "chosen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChosenGapPair"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "identity",
        "parent_identity",
        "relation",
        "weighting_policy",
        "quantile_policy",
        "threshold_hours",
        "kept",
        "parent",
        "pair_count",
        "pairs",
        "pairs_truncated",
        "chosen"
      ]
    },
    "GapPairsRefusal": {
      "title": "GapPairsRefusal",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "message_type": {
          "type": "string",
          "const": "gap_pairs_refusal"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "type": "string",
          "const": "gap_pairs"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unsupported_schema",
            "invalid_parameter",
            "workspace_unavailable",
            "workspace_not_writable",
            "workspace_incompatible",
            "source_unavailable",
            "preparation_unavailable",
            "identity_mismatch",
            "population_unavailable",
            "memory_unavailable",
            "computation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "query_revision",
        "workspace_id",
        "operation",
        "code",
        "message",
        "field",
        "retryable"
      ]
    }
  }
}
