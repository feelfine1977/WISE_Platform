{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-platform.local/contracts/bpic19-prepared-input.v1.schema.json",
  "title": "Bpic19PreparedInput",
  "description": "Closed version 1 artifact for declared historical29 prepared-attribute arithmetic. No original-row derivation, executable expressions, custom algorithms, generic norms or HTTP admission. All 29 cells are required per assessment item. The validator additionally enforces unique item/assessment identities, assessment-reference integrity, presentation permutation and the content checksum. This slice does not close T25-AC07 or prove raw-adapter equivalence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_kind": {
      "const": "bpic19.prepared-input"
    },
    "profile_id": {
      "const": "bpic19.notebook.1.0-paper-aligned.v1"
    },
    "catalogue_sha256": {
      "const": "498d0464d11ede078bf75818d0b329ff946077ffbe93a4b6f5f4aaf27eeddaef",
      "description": "Immutable upstream historical29 catalogue authority for prepared-v1 declarations; not the digest of a distribution copy. The separately verified distribution omits only the unused private source default. Native norm metadata reports its actual packaged digest, upstream digest and named adaptation; see docs/prepared-catalogue-provenance.md."
    },
    "input_policy": {
      "const": "declared_prepared_measurements.v1"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AssessmentRow"
      },
      "description": "Declared assessment order is meaningful and hashed. These are not original event rows."
    },
    "content_id": {
      "type": "string",
      "pattern": "^bpic19-prepared-input\\.v1:sha256:[a-f0-9]{64}$",
      "description": "preparation.content_identity convention: SHA-256 of UTF-8 compact sorted-key JSON, ensure_ascii=false, allow_nan=false, excluding content_id and presentation only. All declared array orders and provenance enter the hash."
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "item_order"
      ],
      "description": "Optional display-only permutation of item identities; excluded from content identity. JSON object field ordering is also immaterial."
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "profile_id",
    "catalogue_sha256",
    "input_policy",
    "rows",
    "content_id"
  ],
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "DeclaredOriginalRowReference": {
      "description": "An unverified declaration only; never manufacture or load a source row to satisfy it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source\\.v1:sha256:[a-f0-9]{64}$"
        },
        "row_id": {
          "type": "string",
          "pattern": "^row\\.v1:sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_id",
        "row_id"
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "declared_prepared_measurement"
        },
        "declaration_ref": {
          "$ref": "#/$defs/Text"
        },
        "assessment_row_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "original_row_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeclaredOriginalRowReference"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "declaration_ref",
        "assessment_row_refs",
        "original_row_refs"
      ],
      "description": "Provenance is declared, never verified by this contract. Assessment references must name rows in this artifact and include the owning row. Original references may be empty and assert neither source presence nor a raw witness. Array order is part of content identity."
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/Text"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "state",
        "value",
        "reason",
        "unit",
        "provenance"
      ],
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "$ref": "#/$defs/Text"
            }
          }
        }
      ],
      "description": "An available numeric zero is evidence distinct from unavailable. Numbers must be finite JSON numbers; booleans, NaN and Infinity are forbidden. Availability is independent of flow applicability; no cross-cell physical history consistency is asserted."
    },
